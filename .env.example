# ==============================================================================
# SPARTA DC-Development — Environment Variables Configuration Template
# ==============================================================================
# Salin file ini menjadi .env atau .env.local dan sesuaikan nilai variabelnya:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & ORM (PostgreSQL & Prisma)
# ------------------------------------------------------------------------------
# URL koneksi ke database PostgreSQL
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]?sslmode=disable
DATABASE_URL="postgresql://postgres:password@localhost:5432/DC-Development?sslmode=disable"

# ------------------------------------------------------------------------------
# 2. AUTENTIKASI & KEAMANAN (JWT & NextAuth)
# ------------------------------------------------------------------------------
# Kunci rahasia untuk enkripsi/verifikasi session JWT (jose)
JWT_SECRET="ganti-dengan-rahasia-jwt-yang-kuat-minimal-32-karakter"

# Kunci rahasia opsional NextAuth / HMAC rolling token untuk absensi aanwijzing
NEXTAUTH_SECRET="ganti-dengan-rahasia-nextauth-yang-kuat-minimal-32-karakter"

# URL basis aplikasi (lokal atau production)
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. SPARTA PORTAL & EKOSISTEM
# ------------------------------------------------------------------------------
# URL portal SPARTA untuk integrasi email link & redirect
WEB_SPARTA=""
# ------------------------------------------------------------------------------
# 4. GOOGLE DRIVE & GOOGLE WORKSPACE API
# ------------------------------------------------------------------------------
# Path relatif atau absolut ke file OAuth2 token JSON (Gmail & Google Drive)
GOOGLE_TOKEN_PATH="token.json"

# Path relatif atau absolut ke file token JSON khusus upload dokumen drive
GOOGLE_DOC_TOKEN_PATH="token_doc.json"

# ID Google Drive Folder induk untuk penyimpanan dokumen arsip (PDF PFR, Penawaran, BAA)
MASTER_DRIVE_FOLDER_ID="your_google_drive_folder_id_here"

# ------------------------------------------------------------------------------
# 5. PENGIRIMAN EMAIL (SMTP / NODEMAILER)
# ------------------------------------------------------------------------------
# Catatan: Jika GOOGLE_TOKEN_PATH valid, Gmail API OAuth2 akan diprioritaskan.
# Jika menggunakan SMTP fallback, lengkapi konfigurasi berikut:
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS="your_app_password_here"

# Alternatif variabel SMTP standar (jika tidak menggunakan EMAIL_*)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="building_development@sat.co.id"
# SMTP_PASS="your_app_password_here"
# SMTP_FROM="SPARTA DC-Development <building_development@sat.co.id>"

# ------------------------------------------------------------------------------
# 6. PDF GENERATOR (PUPPETEER CHROMIUM) - OPSIONAL
# ------------------------------------------------------------------------------
# Path executable Google Chrome / Chromium jika ingin menggunakan browser eksternal.
# Kosongkan atau abaikan jika menggunakan browser default Puppeteer.
# Contoh Windows: "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
# Contoh Linux  : "/usr/bin/google-chrome-stable"
# PUPPETEER_EXECUTABLE_PATH=""
